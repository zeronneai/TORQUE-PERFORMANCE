{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?action=expire_onetime",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60
    }
  }
}